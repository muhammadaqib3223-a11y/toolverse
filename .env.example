# Copy this file to .env and fill in the values. Never commit .env.

# Which settings to use: development | production | testing
APP_ENV=development

# Long random string used to sign cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# How much detail goes into the logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supabase -> Project Settings -> API Keys.
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=https://ncasoovoadavazfkvxvo.supabase.co
# The PUBLISHABLE key (sb_publishable_...). The legacy "anon" key also works.
# NEVER put the secret / service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_jbHBt1zSzyJC4ePEcg59KA_M0dbog_V

# AI. AI_PROVIDER picks the provider (gemini). Keys stay on the server, never in the browser.
AI_PROVIDER=gemini
# Google AI Studio -> https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
# Optional: change the Gemini model without touching code.
GEMINI_MODEL=gemini-3.5-flash-lite

# Caption Generator daily limits (reset at midnight UTC).
CAPTIONS_GUEST_DAILY_LIMIT=3
CAPTIONS_USER_DAILY_LIMIT=20
# All guests + users together, so the AI's free quota is never used up.
CAPTIONS_SITE_DAILY_LIMIT=500

# Site-wide AI limit: ALL AI tools, guests and users together (replaces CAPTIONS_SITE_DAILY_LIMIT).
# Leave empty to use the default (500).
AI_SITE_DAILY_LIMIT=
# CV Generator "Improve with AI" daily limits. Leave empty for the defaults (guest 3, user 30).
CV_AI_GUEST_DAILY_LIMIT=
CV_AI_USER_DAILY_LIMIT=
