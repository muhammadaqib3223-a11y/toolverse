# Copy this file to .env and fill in the values. Never commit .env.

# Which settings to use: development | production | testing
APP_ENV=development

# Long random string used to sign cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# How much detail goes into the logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supabase -> Project Settings -> API Keys.
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...). The legacy "anon" key also works.
# NEVER put the secret / service_role key here.
SUPABASE_PUBLISHABLE_KEY=
