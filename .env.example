# Copy this file to .env and fill in the values. Never commit .env.

# Which settings to use: development | production | testing
APP_ENV=development

# Long random string used to sign cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# How much detail goes into the logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
