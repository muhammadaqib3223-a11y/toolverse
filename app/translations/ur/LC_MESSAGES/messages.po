#: app/blueprints/marketing/tools_catalog.py:286
msgid "Expenses"
msgstr "اخراجات"

#: app/blueprints/marketing/content.py:36 app/templates/partials/navbar.html:41
#: app/templates/partials/navbar.html:61
msgid "Sign up free"
msgstr "مفت سائن اپ کریں"

#: app/blueprints/marketing/content.py:36
msgid "With email or Google."
msgstr "ای میل یا گوگل کے ساتھ۔"

#: app/blueprints/marketing/content.py:37
msgid "Pick a tool"
msgstr "ٹول چنیں"

#: app/blueprints/marketing/content.py:37
msgid "All five live on your dashboard."
msgstr "پانچوں ٹولز آپ کے ڈیش بورڈ پر موجود ہیں۔"

#: app/blueprints/marketing/content.py:38
msgid "It's all saved"
msgstr "سب کچھ محفوظ ہے"

#: app/blueprints/marketing/content.py:38
msgid "Come back anytime, any device."
msgstr "کبھی بھی، کسی بھی ڈیوائس سے واپس آئیں۔"

#: app/blueprints/marketing/content.py:42
msgid "No credit card"
msgstr "کوئی کریڈٹ کارڈ نہیں"

#: app/blueprints/marketing/content.py:43
msgid "No paid plans"
msgstr "کوئی پیڈ پلان نہیں"

#: app/blueprints/marketing/content.py:44
msgid "All five tools included"
msgstr "پانچوں ٹولز شامل"

#: app/blueprints/marketing/content.py:49
msgid "Is Toolverse really free?"
msgstr "کیا ٹول ورس واقعی مفت ہے؟"

#: app/blueprints/marketing/content.py:50
msgid "Yes. All five tools are free, with no paid plans and no credit card. AI tools have a fair daily limit so they stay free for everyone."
msgstr "جی ہاں۔ پانچوں ٹولز مفت ہیں، نہ کوئی پیڈ پلان ہے اور نہ کریڈٹ کارڈ چاہیے۔ اے آئی ٹولز کی ایک مناسب روزانہ حد ہے تاکہ یہ سب کے لیے مفت رہیں۔"

#: app/blueprints/marketing/content.py:54
msgid "Why do I need to log in?"
msgstr "مجھے لاگ ان کیوں کرنا ہوگا؟"

#: app/blueprints/marketing/content.py:55
msgid "So your CVs, notes and expenses are saved to your own account and stay private to you, on any device."
msgstr "تاکہ آپ کی سی وی، نوٹس اور اخراجات آپ کے اپنے اکاؤنٹ میں محفوظ رہیں اور صرف آپ تک محدود رہیں، کسی بھی ڈیوائس پر۔"

#: app/blueprints/marketing/content.py:59
msgid "Is my CV safe?"
msgstr "کیا میری سی وی محفوظ ہے؟"

#: app/blueprints/marketing/content.py:60
msgid "Yes. Your CV is stored privately and only you can open it. We never share it."
msgstr "جی ہاں۔ آپ کی سی وی نجی طور پر محفوظ کی جاتی ہے اور صرف آپ ہی اسے کھول سکتے ہیں۔ ہم اسے کبھی کسی کے ساتھ شیئر نہیں کرتے۔"

#: app/blueprints/marketing/content.py:63
msgid "Can I use it in Urdu?"
msgstr "کیا اسے اردو میں استعمال کیا جا سکتا ہے؟"

#: app/blueprints/marketing/content.py:64
msgid "Yes. Switch to Urdu from the menu at the top and the whole site changes to Urdu."
msgstr "جی ہاں۔ اوپر والے مینو سے اردو چنیں اور پوری سائٹ اردو میں بدل جائے گی۔"

#: app/blueprints/marketing/content.py:70 app/templates/partials/navbar.html:40
#: app/templates/partials/navbar.html:60
msgid "Log in"
msgstr "لاگ ان"

#: app/blueprints/marketing/content.py:71
msgid "Accounts are almost ready. Soon you can log in with email or Google and find all your work saved."
msgstr "اکاؤنٹس تقریباً تیار ہیں۔ جلد ہی آپ ای میل یا گوگل سے لاگ ان کر سکیں گے اور اپنا سارا کام محفوظ پائیں گے۔"

#: app/blueprints/marketing/content.py:75
msgid "Sign up"
msgstr "سائن اپ"

#: app/blueprints/marketing/content.py:76
msgid "Free accounts are almost ready. Soon you can sign up with email or Google in under a minute."
msgstr "مفت اکاؤنٹس تقریباً تیار ہیں۔ جلد ہی آپ ای میل یا گوگل سے ایک منٹ سے بھی کم میں سائن اپ کر سکیں گے۔"

#: app/blueprints/marketing/content.py:80 app/templates/partials/footer.html:5
msgid "Privacy"
msgstr "پرائیویسی"

#: app/blueprints/marketing/content.py:81
msgid "We are writing a clear, simple privacy policy. It will be here soon."
msgstr "ہم ایک واضح اور سادہ پرائیویسی پالیسی لکھ رہے ہیں۔ یہ جلد یہاں ہوگی۔"

#: app/blueprints/marketing/content.py:84 app/templates/partials/footer.html:6
msgid "Terms"
msgstr "شرائط"

#: app/blueprints/marketing/content.py:85
msgid "We are writing simple, fair terms of use. They will be here soon."
msgstr "ہم استعمال کی سادہ اور منصفانہ شرائط لکھ رہے ہیں۔ یہ جلد یہاں ہوں گی۔"

#: app/blueprints/marketing/content.py:88 app/templates/partials/footer.html:7
msgid "Contact"
msgstr "رابطہ"

#: app/blueprints/marketing/content.py:89
msgid "A contact page is on its way. It will be here soon."
msgstr "رابطے کا صفحہ تیار ہو رہا ہے۔ یہ جلد یہاں ہوگا۔"

#: app/blueprints/marketing/tools_catalog.py:29
msgid "All"
msgstr "سب"

#: app/blueprints/marketing/tools_catalog.py:30
msgid "CV"
msgstr "سی وی"

#: app/blueprints/marketing/tools_catalog.py:31
msgid "Writing"
