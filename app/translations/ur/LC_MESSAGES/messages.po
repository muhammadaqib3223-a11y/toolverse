msgid "Accounts are almost ready. Soon you can log in with email or Google and find all your work saved."
msgstr "اکاؤنٹس تقریباً تیار ہیں۔ جلد ہی آپ ای میل یا گوگل سے لاگ ان کر سکیں گے اور اپنا سارا کام محفوظ پائیں گے۔"

#: app/blueprints/marketing/content.py:75
msgid "Sign up"
msgstr "سائن اپ"

#: app/blueprints/marketing/content.py:76
msgid "Free accounts are almost ready. Soon you can sign up with email or Google in under a minute."
msgstr "مفت اکاؤنٹس تقریباً تیار ہیں۔ جلد ہی آپ ای میل یا گوگل سے ایک منٹ سے بھی کم میں سائن اپ کر سکیں گے۔"

#: app/blueprints/marketing/content.py:80 app/templates/partials/footer.html:5
